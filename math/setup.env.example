# setup.env 模板 —— 本次「几何样本筛选蒸馏」实验专用
# 用法: 复制到项目根目录为 setup.env, 填好路径后 source setup.env
#   cp math/setup.env.example setup.env && 编辑 && source setup.env
# 真实 setup.env 已被 .gitignore 排除。
#
# 说明: 本研究主线全部使用【本地开源模型】, 不需要任何闭源 API 密钥。
#       下面只列本次实验真正用到的变量。

# ── Python 解释器 (需装好 requirements.txt 的环境) ──
export EASYEDIT_PY="/path/to/your/python3"          # 改成你的: which python3

# ── 学生模型 (Choice-Head 蒸馏的被训练方) ──
export BASE_MODEL_14B="$PWD/models/Qwen2.5-14B-Instruct"

# ── 教师模型 (生成 logprobs 软标签; 按需下载, 见 math/复现指南.md 第1节) ──
# 强教师
export TEACHER_QWEN32B="$PWD/models/Qwen2.5-32B-Instruct"
export TEACHER_GLM32B="$PWD/models/GLM-4-32B-0414"
# 中等教师
export TEACHER_YI34B="$PWD/models/Yi-1.5-34B-Chat"
# 弱教师
export TEACHER_GEMMA27B="$PWD/models/gemma-2-27b-it"
export TEACHER_PHI4="$PWD/models/phi-4"

# ── 可选: HuggingFace 下载加速 ──
# export HF_ENDPOINT="https://hf-mirror.com"         # 国内镜像(datasets用官方源直连更稳)
# export HF_HUB_ENABLE_HF_TRANSFER=0                 # 下载 MMLU/MedQA 时建议设0
# export HF_TOKEN=""                                  # 仅下载 gemma-2 等需许可的模型时填

# ── 跨数据集实验 (MedQA) 切英文 prompt ──
# 由 run_medqa_distill.sh 自动设置, 无需手动:
# export DISTILL_PROMPT_LANG=en
