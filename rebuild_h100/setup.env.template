# mentalDistill 环境激活模板。
# 重建后: cp rebuild_h100/setup.env.template setup.env, 填入真实 API keys, 然后 source setup.env
# ⚠️ setup.env 含密钥，务必在 .gitignore 里，绝不提交。

# ── Python 解释器（anaconda base）──
export EASYEDIT_PY="$HOME/anaconda3/bin/python3"

# ── 模型路径 ──
export BASE_MODEL_7B="$HOME/arthas/mentalDistill/models/Qwen2.5-7B-Instruct"
export BASE_MODEL_14B="$HOME/arthas/mentalDistill/models/Qwen2.5-14B-Instruct"
export BASE_MODEL_32B="$HOME/arthas/mentalDistill/models/Qwen2.5-32B-Instruct"
export BASE_MODEL_QWEN3_14B="$HOME/arthas/mentalDistill/models/Qwen3-14B"

# ── API Keys（从你自己的密码管理器填，勿提交）──
export DEEPSEEK_API_KEY="填这里"     # platform.deepseek.com（主教师）
export DOUBAO_API_KEY="填这里"       # 火山引擎
export MOONSHOT_API_KEY="填这里"     # platform.moonshot.cn
export DASHSCOPE_API_KEY="填这里"    # 阿里云 DashScope

# ── 快捷命令（原机器上曾定义，按需保留）──
hermes_env(){ source "$HOME/anaconda3/etc/profile.d/conda.sh"; conda activate hermes; }
vllm_env(){ source "$HOME/anaconda3/etc/profile.d/conda.sh"; conda activate vllm; }
start_vllm(){ vllm_env; nohup python -m vllm.entrypoints.openai.api_server \
  --model "$HOME/arthas/mentalDistill/models/Llama-3.3-70B-Instruct-AWQ" \
  --quantization awq --port 8000 > /tmp/vllm.log 2>&1 & echo "vLLM 启动中，日志 /tmp/vllm.log"; }
stop_vllm(){ pkill -f vllm.entrypoints || true; }
vllm_log(){ tail -f /tmp/vllm.log; }
check_env(){ "$EASYEDIT_PY" -c 'import torch;print("torch",torch.__version__,"cuda",torch.cuda.is_available())'; nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader; }

echo "已加载 mentalDistill 环境。快捷命令: hermes_env / vllm_env / start_vllm / stop_vllm / vllm_log / check_env"
