# setup.env 模板 —— 复制为 setup.env 并填入你的实际路径/密钥后使用
# 真实 setup.env 已被 .gitignore 排除（含密钥，不上传）
#   cp setup.env.example setup.env  然后编辑

# Python 解释器（指向你的 conda/venv 环境，需装好 requirements.txt）
export EASYEDIT_PY="/path/to/your/python3"

# 基座/学生模型路径（从 HuggingFace 下载后存放，见 docs/复现指南.md）
export BASE_MODEL_7B="$PWD/models/Qwen2.5-7B-Instruct"
export BASE_MODEL_14B="$PWD/models/Qwen2.5-14B-Instruct"
export BASE_MODEL_32B="$PWD/models/Qwen2.5-32B-Instruct"
export BASE_MODEL_QWEN3_14B="$PWD/models/Qwen3-14B"

# API 密钥（仅在用闭源教师 API 时需要；本研究主线用本地模型，可留空）
export DEEPSEEK_API_KEY=""
export DOUBAO_API_KEY=""
export MOONSHOT_API_KEY=""
export DASHSCOPE_API_KEY=""
